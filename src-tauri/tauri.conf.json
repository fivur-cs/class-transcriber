{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Class Transcriber",
  "version": "0.1.0",
  "identifier": "com.fivur.class-transcriber",

  "build": {
    "frontendDist": "../src"
  },

  "app": {
    "withGlobalTauri": true,

    "windows": [
      {
        "label": "main",
        "title": "Class Transcriber",
        "width": 850,
        "height": 700,
        "minWidth": 720,
        "minHeight": 700,
        "resizable": true,
        "center": true
      }
    ],

    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "img-src": "'self' asset: data:",
        "style-src": "'self' 'unsafe-inline'",
        "script-src": "'self'"
      }
    }
  },

  "bundle": {
    "active": true,
    "targets": "all",

    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}